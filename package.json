{
	"name": "fundacionsoycuerpo-web",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm-run-all test:unit test:build:run",
		"test:unit": "playwright test",
		"test:build:run": "npm-run-all build cy:run",
		"cy:run": "cypress run",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@playwright-testing-library/test": "^4.5.0",
		"@playwright/test": "^1.45.3",
		"@sveltejs/adapter-netlify": "^4.4.2",
		"@sveltejs/kit": "^2.48.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@testing-library/cypress": "^8.0.7",
		"@types/cookie": "^0.5.4",
		"@types/marked": "^4.3.2",
		"@typescript-eslint/eslint-plugin": "^5.62.0",
		"@typescript-eslint/parser": "^5.62.0",
		"cypress": "^9.7.0",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^8.10.0",
		"eslint-plugin-svelte3": "^4.0.0",
		"marked": "^4.3.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.42.2",
		"svelte-check": "^4.3.3",
		"svelte-preprocess": "^6.0.3",
		"tslib": "^2.6.3",
		"typescript": "^5.9.3",
		"vite": "^5.4.21"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	}
}
